# Build
build/
cmake-build-*/
*.so
*.pyd
*.dylib
_hypergamic*.pyd
_hypergamic*.so

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
.venv/
venv/

# Models — keep .gitkeep, ignore weights
models/*.pt
models/*.pth
models/*.ckpt

# Data — keep .gitkeep, ignore outputs
data/raw/*.csv
data/raw/*.npz
data/raw/*.parquet
data/processed/*.csv
data/processed/*.npz
data/processed/*.parquet
# Per-agent H2 panel, ~20 MB; regenerated by scripts/run_flooding.py. The
# summaries beside it are small and tracked.
data/processed/flooding/panel.parquet

# Profiling
profile.out
*.prof

# Jupyter
.ipynb_checkpoints/
notebooks/.ipynb_checkpoints/

# Figures. Generated at runtime by scripts/make_figures.py, but the three
# headline figures are tracked because the README embeds them and GitHub renders
# from the repository, not from a local build. Everything else here stays ignored.
docs/figures/*.png
docs/figures/*.gif
docs/figures/*.svg
!docs/figures/separating_curve.png
!docs/figures/thin_market_curve.png
!docs/figures/decomposition.png
!docs/figures/arm_comparison.png
!docs/figures/gini_evolution.png
!docs/figures/matthew_effect.png
!docs/figures/attribution.png
# The demo notebook's figures. dashboard, matthew and sweep are the three the README
# embeds, so they are tracked for the same reason as the seven above; population and
# pareto exist only inline in notebooks/demo.ipynb and stay ignored.
!docs/figures/dashboard.png
!docs/figures/matthew.png
!docs/figures/sweep.png

# OS
.DS_Store
Thumbs.db

# Profiling scratch: timing harnesses and per-run dumps. docs/PERFORMANCE.md describes
# them; they are not part of the repository and would fail the lint job.
data/perf/

# Session prompt log: a record of how the work was done, kept outside the repository.
docs/SPRINT_PROMPTS.md
